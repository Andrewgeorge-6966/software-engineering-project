# PostgreSQL connection used by the application
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Direct PostgreSQL connection used by Prisma migrations
DIRECT_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Use a long, randomly generated value outside local development
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

# Supabase project configuration
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_BUCKET=campuscare-images

# Comma-separated domains allowed during registration
UNIVERSITY_EMAIL_DOMAINS=example.edu,students.example.edu

PORT=3000
